# Oh My Niu environment packs.
#
# An environment pack ("env") is a small TOML file that declares which WPM
# packages to install, which oh-my-niu plugins to enable, and which
# environment variables to export. It is provisioning, not a plugin kind:
# wpm owns package installation and this library only orchestrates.
#
# Commands:
#   niu env list            list built-in and custom envs
#   niu env show <env>      print what an env would do without changing anything
#   niu env use <env>       install packages, enable plugins, export variables
#
# <env> is a name under $NIUBASH/envs (or $NIU_CUSTOM/envs), a path to a
# .toml file, or an http(s):// URL.

# Prints one item per line from a TOML string-array literal such as
# ["git", "jq"], an empty array, or a bare quoted string. Only quoted items
# are emitted, so trailing comments and separators are ignored naturally.
__omw_env_array_items() {
  local raw="$1" remainder item
  remainder="$raw"
  while [ -n "$remainder" ]; do
    case "$remainder" in
      \"*)
        remainder="${remainder#\"}"
        item="${remainder%%\"*}"
        remainder="${remainder#*\"}"
        [ -n "$item" ] && printf '%s\n' "$item"
        ;;
      *) remainder="${remainder#?}" ;;
    esac
  done
}

__omw_env_unquote() {
  local value="$1"
  case "$value" in
    \"*\") value="${value#\"}"; value="${value%\"}" ;;
  esac
  printf '%s\n' "$value"
}

# Consumes additional lines from the env file until a line containing ']'.
# Used for arrays written across multiple lines.
__omw_env_collect_lines() {
  local line acc=""
  while IFS= read -r line; do
    line="${line%$'\r'}"
    acc="$acc $line"
    case "$line" in *\]) break ;; esac
  done
  printf '%s\n' "$acc"
}

# Resolves an env spec to a readable .toml file path and prints it. Returns 1
# when the spec cannot be resolved. Downloaded URLs land in a temp file.
__omw_env_resolve() {
  local spec="$1" candidate
  case "$spec" in
    http://* | https://*)
      candidate="${TMPDIR:-/tmp}/niu-env-$$-$RANDOM.toml"
      if command -v curl >/dev/null 2>&1; then
        curl -fsSL "$spec" -o "$candidate" || return 1
      else
        echo "niu env: curl is required to fetch remote env files" >&2
        return 1
      fi
      printf '%s\n' "$candidate"
      return 0
      ;;
    *".toml")
      if [ -f "$spec" ]; then
        printf '%s\n' "$spec"
        return 0
      fi
      ;;
  esac

  for candidate in "$NIU_CUSTOM/envs/$spec.toml" "$NIUBASH/envs/$spec.toml"; do
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

# Parses an env file and sets:
#   NIU_ENV_FILE          resolved file path
#   NIU_ENV_DESCRIPTION   string from [meta] description
#   NIU_ENV_PACKAGES      newline-separated [packages] wpm entries
#   NIU_ENV_PLUGINS       newline-separated [plugins] enable entries
#   NIU_ENV_ENV_KEYS      newline-separated [env] key names
#   NIU_ENV_ENV_<KEY>     value per [env] key (dashes map to underscores)
# Returns 1 when the file is missing or declares no [packages] section.
niu_env_parse() {
  local file="$1" section="" key raw value sanitized had_packages=0
  NIU_ENV_FILE="$file"
  NIU_ENV_DESCRIPTION=""
  NIU_ENV_PACKAGES=""
  NIU_ENV_PLUGINS=""
  NIU_ENV_ENV_KEYS=""

  [ -f "$file" ] || {
    echo "niu env: cannot read env file: $file" >&2
    return 1
  }

  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
      "" | \#*) continue ;;
      \[*\])
        section="${line#\[}"
        section="${section%\]}"
        continue
        ;;
    esac
    case "$line" in
      *=*) ;;
      *) continue ;;
    esac
    key="${line%%=*}"
    raw="${line#*=}"
    key="${key#"${key%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    raw="${raw#"${raw%%[![:space:]]*}"}"
    raw="${raw%"${raw##*[![:space:]]}"}"
    case "$section" in
      meta)
        [ "$key" = "description" ] &&
          NIU_ENV_DESCRIPTION="$(__omw_env_unquote "$raw")"
        ;;
      packages)
        if [ "$key" = "wpm" ]; then
          case "$raw" in
            *\]) ;;
            \[*) raw="$raw $(__omw_env_collect_lines)" ;;
          esac
          NIU_ENV_PACKAGES="$(__omw_env_array_items "$raw")"
          had_packages=1
        fi
        ;;
      plugins)
        if [ "$key" = "enable" ]; then
          case "$raw" in
            *\]) ;;
            \[*) raw="$raw $(__omw_env_collect_lines)" ;;
          esac
          NIU_ENV_PLUGINS="$(__omw_env_array_items "$raw")"
        fi
        ;;
      env)
        value="$(__omw_env_unquote "$raw")"
        sanitized="${key//-/_}"
        NIU_ENV_ENV_KEYS="${NIU_ENV_ENV_KEYS}${key}"$'\n'
        printf -v "NIU_ENV_ENV_${sanitized}" '%s' "$value"
        ;;
    esac
  done <"$file"

  [ "$had_packages" -eq 1 ] || {
    echo "niu env: $file has no [packages] wpm list" >&2
    return 1
  }
  return 0
}

niu_env_list() {
  local file name found=0
  for file in "$NIUBASH/envs"/*.toml "$NIU_CUSTOM/envs"/*.toml; do
    [ -f "$file" ] || continue
    name="$(basename "$file" .toml)"
    niu_env_parse "$file" || continue
    found=1
    printf '  %-10s %s\n' "$name" "${NIU_ENV_DESCRIPTION:-}"
    printf '             packages: %s; plugins: %s\n' \
      "$(echo "$NIU_ENV_PACKAGES" | paste -sd, -)" \
      "$(echo "$NIU_ENV_PLUGINS" | paste -sd, -)"
  done
  [ "$found" -eq 1 ] ||
    echo "niu env: no environment packs found in $NIUBASH/envs"
}

niu_env_show() {
  local file
  file="$(__omw_env_resolve "$1")" || {
    echo "niu env: unknown environment: $1" >&2
    return 1
  }
  niu_env_parse "$file" || return 1
  echo "env:        $(basename "$file" .toml)"
  echo "file:       $file"
  echo "packages:   $(echo "$NIU_ENV_PACKAGES" | paste -sd, -)"
  echo "plugins:    $(echo "$NIU_ENV_PLUGINS" | paste -sd, -)"
  echo "env:        $(echo "$NIU_ENV_ENV_KEYS" | paste -sd, -)"
}

niu_env_use() {
  local file plugin plugin_file plugin_custom plugin_bundle key sanitized
  file="$(__omw_env_resolve "$1")" || {
    echo "niu env: unknown environment: $1" >&2
    return 1
  }
  niu_env_parse "$file" || return 1
  echo "niu env: applying $(basename "$file" .toml) ($file)"

  if [ -n "$NIU_ENV_PACKAGES" ]; then
    if command -v wpm >/dev/null 2>&1; then
      wpm install --from "$file" || echo "niu env: some packages failed to install" >&2
    else
      echo "niu env: wpm not found; skipped package installation" >&2
    fi
  fi

  for plugin in $NIU_ENV_PLUGINS; do
    case " ${NIU_PLUGINS[*]-} " in
      *" $plugin "*) ;;
      *)
        NIU_PLUGINS+=("$plugin")
        plugin_custom="$NIU_CUSTOM/plugins/$plugin/$plugin.plugin.niu"
        plugin_bundle="$NIUBASH/plugins/$plugin/$plugin.plugin.niu"
        if [ -f "$plugin_custom" ]; then
          . "$plugin_custom"
        elif [ -f "$plugin_bundle" ]; then
          . "$plugin_bundle"
        else
          echo "niu env: plugin '$plugin' not found; it will load on the next shell if installed" >&2
        fi
        ;;
    esac
  done

  for key in $NIU_ENV_ENV_KEYS; do
    sanitized="${key//-/_}"
    eval "export ${key}=\"\$NIU_ENV_ENV_${sanitized}\""
  done

  echo "niu env: done. To keep plugins across shells, add them to NIU_PLUGINS in your .niubashrc:"
  echo "  NIU_PLUGINS=(${NIU_PLUGINS[*]-})"
}

niu_env() {
  case "${1:-}" in
    list) shift; niu_env_list "$@" ;;
    show)
      [ -n "${2:-}" ] || {
        echo "niu env: usage: niu env show <env>" >&2
        return 1
      }
      shift; niu_env_show "$@"
      ;;
    use)
      [ -n "${2:-}" ] || {
        echo "niu env: usage: niu env use <env>" >&2
        return 1
      }
      shift; niu_env_use "$@"
      ;;
    "" | help | -h | --help)
      echo "usage: niu env list | show <env> | use <env>"
      ;;
    *)
      echo "niu env: unknown command: $1" >&2
      echo "usage: niu env list | show <env> | use <env>" >&2
      return 1
      ;;
  esac
}
