# Hook registry for framework-loaded plugins.
#
# Niubash core calls these hook runners from its interactive lifecycle.
# This shell-level registry makes the plugin contract visible and easy to port.
#
# Supported hooks (comprehensive, matching ZSH/FISH capabilities):
#
# Lifecycle hooks:
#   startup       - shell startup (after rc loaded)
#   precmd        - before each prompt display
#   preexec       - before command execution
#   postcmd       - after command execution (FISH fish_postcmd)
#   chpwd         - directory change
#   period        - periodic timer (every NIU_PERIOD_SECONDS seconds)
#   zshaddhistory - after command added to history
#   zshexit       - shell exit
#   greeting      - startup greeting (FISH fish_greeting)
#   title         - terminal title update (FISH fish_title)
#
# Trap hooks (signal-based):
#   trapdebug     - debug trap (ZSH TRAPDEBUG)
#   traperr       - error trap (ZSH TRAPERR)
#   trapint       - interrupt trap (ZSH TRAPINT)
#   trapwinch     - window resize (ZSH TRAPWINCH)
#   trapusr1      - user signal 1 (ZSH TRAPUSR1)
#   trapusr2      - user signal 2 (ZSH TRAPUSR2)
#   trappipe      - pipe error (ZSH TRAPPIPE)
#   trapterm      - termination (ZSH TRAPTERM)
#   trapchld      - child process exit (ZSH TRAPCHLD)
#   trapzerr      - ZSH error trap

__niubash_hook_list_add() {
  __omw_hook_var="$1"
  __omw_hook_name="$2"
  eval "__omw_hook_current=\${$__omw_hook_var:-}"
  case " $__omw_hook_current " in
    *" $__omw_hook_name "*) ;;
    *)
      if [ -n "$__omw_hook_current" ]; then
        eval "export ${__omw_hook_var}=\"\${__omw_hook_current} \${__omw_hook_name}\""
      else
        eval "export ${__omw_hook_var}=\"\${__omw_hook_name}\""
      fi
      ;;
  esac
}

# --- Lifecycle hook registration ---

niubash_add_startup_hook() {
  __niubash_hook_list_add NIU_STARTUP_HOOKS "$1"
}

niubash_add_precmd_hook() {
  __niubash_hook_list_add NIU_PRECMD_HOOKS "$1"
}

niubash_add_preexec_hook() {
  __niubash_hook_list_add NIU_PREEXEC_HOOKS "$1"
}

niubash_add_postcmd_hook() {
