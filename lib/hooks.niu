}

niubash_add_chpwd_hook() {
  __niubash_hook_list_add NIU_CHPWD_HOOKS "$1"
}

niubash_add_period_hook() {
  __niubash_hook_list_add NIU_PERIOD_HOOKS "$1"
}

niubash_add_zshaddhistory_hook() {
  __niubash_hook_list_add NIU_ZSHADDHISTORY_HOOKS "$1"
}

niubash_add_zshexit_hook() {
