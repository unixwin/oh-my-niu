}

# --- Hook runner functions ---

niubash_run_hooks() {
  __omw_hook_list="$1"
  for __omw_hook_name in $__omw_hook_list; do
    "$__omw_hook_name"
  done
}

# Lifecycle runners
niubash_run_startup_hooks() {
  niubash_run_hooks "$NIU_STARTUP_HOOKS"
}

niubash_run_precmd_hooks() {
  niubash_run_hooks "$NIU_PRECMD_HOOKS"
}

niubash_run_preexec_hooks() {
  niubash_run_hooks "$NIU_PREEXEC_HOOKS"
}

niubash_run_postcmd_hooks() {
  niubash_run_hooks "$NIU_POSTCMD_HOOKS"
}

niubash_run_chpwd_hooks() {
  niubash_run_hooks "$NIU_CHPWD_HOOKS"
}

niubash_run_period_hooks() {
  niubash_run_hooks "$NIU_PERIOD_HOOKS"
