# Lambda-style official theme plugin.

[ -f "$NIUBASH/lib/prompt.winux" ] && . "$NIUBASH/lib/prompt.winux"

NIU_ACTIVE_THEME=lambda
NIU_THEME_FILE="$NIUBASH/themes/lambda.toml"
NIU_PROMPT_SYMBOL="${NIU_PROMPT_SYMBOL:-λ}"
NIU_THEME_GIT_PROMPT_PREFIX="${NIU_THEME_GIT_PROMPT_PREFIX:-}"
NIU_THEME_GIT_PROMPT_SUFFIX="${NIU_THEME_GIT_PROMPT_SUFFIX:- }"
NIU_THEME_GIT_PROMPT_DIRTY="${NIU_THEME_GIT_PROMPT_DIRTY:- *}"
NIU_THEME_GIT_PROMPT_CLEAN="${NIU_THEME_GIT_PROMPT_CLEAN:-}"
export NIU_ACTIVE_THEME NIU_THEME_FILE NIU_PROMPT_SYMBOL
export NIU_THEME_GIT_PROMPT_PREFIX NIU_THEME_GIT_PROMPT_SUFFIX
export NIU_THEME_GIT_PROMPT_DIRTY NIU_THEME_GIT_PROMPT_CLEAN

niubash_prompt_use_template "{prompt_char} {cwd}/ {git}" ""
