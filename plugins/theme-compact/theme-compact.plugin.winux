# Compact official theme plugin.

[ -f "$NIUBASH/lib/prompt.winux" ] && . "$NIUBASH/lib/prompt.winux"

NIU_ACTIVE_THEME=compact
NIU_THEME_FILE="$NIUBASH/themes/compact.toml"
NIU_PROMPT_SYMBOL="${NIU_PROMPT_SYMBOL:-%}"
export NIU_ACTIVE_THEME NIU_THEME_FILE NIU_PROMPT_SYMBOL

niubash_prompt_use_template "{cwd_base} {git}{prompt_char} " ""
