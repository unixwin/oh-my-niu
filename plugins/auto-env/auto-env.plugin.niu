# Oh My Niu auto-env plugin.
#
# Watches the current directory: when it contains a Python virtual
# environment (`.venv`), the venv is activated for that directory and
# deactivated again when you leave. Handles both Windows
# (`.venv/Scripts`) and POSIX (`.venv/bin`) layouts.
#
# Set NIU_AUTO_ENV_DISABLE=1 to turn the whole thing off.

[ -f "$NIUBASH/lib/hooks.winux" ] && . "$NIUBASH/lib/hooks.winux"

__niu_auto_env_deactivate() {
  [ -n "${__niu_auto_env_active:-}" ] || return 0
  __niu_auto_env_new_path=
  __niu_auto_env_IFS=$IFS
  IFS=':'
  for __niu_auto_env_entry in $PATH; do
    case "$__niu_auto_env_entry" in
      "$__niu_auto_env_active"|"$__niu_auto_env_active"/*) ;;
      *)
        if [ -z "$__niu_auto_env_new_path" ]; then
          __niu_auto_env_new_path=$__niu_auto_env_entry
        else
          __niu_auto_env_new_path="$__niu_auto_env_new_path:$__niu_auto_env_entry"
        fi
        ;;
    esac
  done
  IFS=$__niu_auto_env_IFS
  PATH=$__niu_auto_env_new_path
  export PATH
  unset VIRTUAL_ENV __niu_auto_env_active
  unset __niu_auto_env_IFS __niu_auto_env_entry __niu_auto_env_new_path
}

__niu_auto_env_chpwd() {
  [ "${NIU_AUTO_ENV_DISABLE:-0}" = "1" ] && return 0
  __niu_auto_env_found=
  for __niu_auto_env_candidate in .venv/Scripts .venv/bin; do
    if [ -d "$__niu_auto_env_candidate" ]; then
      __niu_auto_env_found=$PWD/${__niu_auto_env_candidate}
      break
    fi
  done
  case "${__niu_auto_env_active:-}" in
    "$__niu_auto_env_found") return 0 ;;
  esac
  __niu_auto_env_deactivate
  [ -n "$__niu_auto_env_found" ] || return 0
  __niu_auto_env_active=$__niu_auto_env_found
  PATH=$__niu_auto_env_active:$PATH
  export PATH
  VIRTUAL_ENV=${__niu_auto_env_active%/Scripts}
  VIRTUAL_ENV=${VIRTUAL_ENV%/bin}
  export VIRTUAL_ENV
}

niubash_add_chpwd_hook __niu_auto_env_chpwd
# Also check once at startup: covers shells opened directly inside a project
# and last-working-dir restores (registration order puts this after the lwd
# restore hook, so the directory is already final when this runs).
niubash_add_startup_hook __niu_auto_env_chpwd
