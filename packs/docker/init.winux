# oh-my-niu docker plugin
# Static aliases and completion metadata stay in bundle assets.

dsh() {
  if [ -z "$1" ]; then
    echo "usage: dsh <container> [shell]" >&2
    return 2
  fi
  container="$1"
  shift
  shell_name="${1:-sh}"
  docker exec -it "$container" "$shell_name"
}

dclean() {
  docker system prune "$@"
}
