# oh-my-niu thefuck plugin
# Executes the correction returned by thefuck in the current shell.

fuck() {
  command -v thefuck >/dev/null 2>&1 || {
    echo "thefuck is not installed or not on PATH" >&2
    return 127
  }

  __niubash_thefuck_command=$(thefuck "$@") || return
  [ -n "$__niubash_thefuck_command" ] && eval "$__niubash_thefuck_command"
}
