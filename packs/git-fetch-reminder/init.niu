# oh-my-niu git-fetch-reminder plugin
# Runs on the period hook and, when the current directory is a git repo,
# prints a one-line reminder when the branch diverged from its upstream:
# behind (pull needed) or ahead (push pending). Rate-limited to once per
# NIU_GIT_FETCH_INTERVAL seconds (default 600). Set NIU_GIT_FETCH_REMIND=0
# to turn it off.

NIU_GIT_FETCH_INTERVAL=${NIU_GIT_FETCH_INTERVAL:-600}

case "$NIU_PLUGIN_HOOK" in
  period)
    [ "${NIU_GIT_FETCH_REMIND:-1}" = "1" ] || return 0
    command -v git >/dev/null 2>&1 || return 0
    __niu_git_fetch_now=$SECONDS
    __niu_git_fetch_elapsed=$((__niu_git_fetch_now - ${__niu_git_fetch_last_check:=-999999}))
    [ "$__niu_git_fetch_elapsed" -ge "$NIU_GIT_FETCH_INTERVAL" ] || return 0
    __niu_git_fetch_last_check=$__niu_git_fetch_now

    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
    __niu_git_fetch_behind=$(git rev-list --count HEAD..@{upstream} 2>/dev/null) || __niu_git_fetch_behind=0
    __niu_git_fetch_ahead=$(git rev-list --count @{upstream}..HEAD 2>/dev/null) || __niu_git_fetch_ahead=0
    [ "${__niu_git_fetch_behind:-0}" -gt 0 ] && \
      printf '\033[33m⇣ %s commit(s) behind upstream — git pull when ready\033[0m\n' "$__niu_git_fetch_behind"
    [ "${__niu_git_fetch_ahead:-0}" -gt 0 ] && \
      printf '\033[2m⇡ %s commit(s) not pushed yet\033[0m\n' "$__niu_git_fetch_ahead"
    unset __niu_git_fetch_behind __niu_git_fetch_ahead __niu_git_fetch_now __niu_git_fetch_elapsed
    ;;
esac
